<Project Sdk="Microsoft.NET.Sdk">
  <!-- The 64-bit helper: WIA (2.0, falling back to 1.0) and 64-bit TWAIN -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>paperwing-scan</AssemblyName>
    <RootNamespace>Paperwing.Scan</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>..\src\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
    <PackageReference Include="NAPS2.Wia" Version="2.0.3" />
    <PackageReference Include="NAPS2.NTwain" Version="1.0.1" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <InternalsVisibleTo Include="PaperwingScan.Tests" />
  </ItemGroup>
</Project>
