{
  "name": "paperwing",
  "productName": "Paperwing",
  "version": "1.2.4",
  "description": "A free, open-source PDF editor for Windows and macOS, built on BentoPDF.",
  "main": "main.cjs",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Rohan Vijaykumar",
  "homepage": "https://paperwingapp.com",
  "paperwing": {
    "repository": "rohanvijaykumar/paperwing"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "electron .",
    "dev": "node scripts/build-web.mjs && electron .",
    "dist:win": "node scripts/build-web.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/build-web.mjs && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build-web.mjs && electron-builder --linux --publish never",
    "pack": "electron-builder --dir --publish never",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs",
    "test:print": "node --test tests/print.test.mjs",
    "docs:shortcuts": "node scripts/gen-shortcuts-doc.mjs",
    "docs:screenshots": "node scripts/gen-screenshots.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "puppeteer-core": "25.16.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
